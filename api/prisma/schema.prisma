
generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id  String  @id @default(uuid())
  title String
  description String
  status String @default("OPEN")
  createdAt DateTime @default(now())

}